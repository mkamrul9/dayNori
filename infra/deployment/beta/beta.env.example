# Daynori Controlled Private Beta — Environment Configuration Template
# All production and staging credentials must be externally supplied by the repository owner.
# NEVER commit populated values, real API keys, or private signing secrets into Git.

# -----------------------------------------------------------------------------
# Runtime & Environment Identity
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=beta
APP_VERSION=0.1.0-beta.1
DAYNORI_API_URL=https://beta-api.daynori.internal
NEXT_PUBLIC_API_URL=https://beta.daynori.internal/api/v1
PUBLIC_WEB_URL=https://beta.daynori.internal

# -----------------------------------------------------------------------------
# Access Control & Private Beta Boundaries
# -----------------------------------------------------------------------------
# Enforces backend rejection of uninvited registrations
BETA_ACCESS_MODE=private_invitation_only
BETA_ALLOW_PUBLIC_SIGNUP=false
# Secret used by the backend to verify cryptographically issued invitation tokens
BETA_INVITATION_SECRET=replace_with_owner_supplied_secret_min_32_chars
# Maximum allowed active beta users across all cohorts
BETA_MAX_SEATS=50

# -----------------------------------------------------------------------------
# Database Configuration (Least-Privilege Separation)
# -----------------------------------------------------------------------------
# Standard runtime application role (no DDL, restricted to app schema RLS)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=daynori_beta
DB_USER=daynori_runtime
DB_PASSWORD=replace_with_owner_supplied_beta_db_password
DB_POOL_MAX=20

# Administrative role for automated migrations only (never exposed to runtime API)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=daynori_beta
PGUSER=postgres
PGPASSWORD=replace_with_owner_supplied_beta_admin_password

# -----------------------------------------------------------------------------
# Authentication & Tokens
# -----------------------------------------------------------------------------
SUPABASE_JWKS_URL=https://auth.daynori.internal/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://auth.daynori.internal
SUPABASE_JWT_AUDIENCE=daynori-api
SUPABASE_SERVICE_ROLE_KEY=replace_with_owner_supplied_service_role_key

# Secret for issuing and verifying HMAC reauthentication challenge tokens
REAUTH_SECRET=replace_with_owner_supplied_reauth_secret_min_32_chars
REAUTH_TOKEN_EXPIRY_SECONDS=300

# -----------------------------------------------------------------------------
# Storage & Quotas (Private Scope Enforcement)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.beta.daynori.internal
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=replace_with_owner_supplied_storage_key
STORAGE_SECRET_ACCESS_KEY=replace_with_owner_supplied_storage_secret
STORAGE_PRIVATE_BUCKET=daynori-beta-private-assets
STORAGE_QUOTA_BYTES_PER_WORKSPACE=104857600   # 100 MB per beta workspace
STORAGE_MAX_FILE_BYTES=10485760               # 10 MB per individual file

# -----------------------------------------------------------------------------
# Push Notification & Reminders (Controlled Staging Gateway)
# -----------------------------------------------------------------------------
# Web Push VAPID keys
VAPID_PUBLIC_KEY=replace_with_owner_supplied_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_owner_supplied_vapid_private_key
VAPID_SUBJECT=mailto:beta-alerts@daynori.internal

# Android FCM Service Account JSON path
FCM_SERVICE_ACCOUNT_PATH=/secure/credentials/fcm-beta-service-account.json

# -----------------------------------------------------------------------------
# Operational Alerting, Telemetry & Feedback
# -----------------------------------------------------------------------------
LOG_LEVEL=info
REDACT_TELEMETRY=true
# Webhook destination for high-priority worker and API errors (Slack / Matrix)
ALERT_WEBHOOK_URL=https://alerts.daynori.internal/webhook/beta-ops
# Feedback intake destination for in-app bug reports and participant observations
FEEDBACK_INTAKE_ENDPOINT=https://beta-api.daynori.internal/v1/beta/feedback
SUPPORT_EMAIL=beta-support@daynori.internal
