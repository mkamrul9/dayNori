# Disposable test project only. Copy into an ignored .env.preview.local file.
# Never copy local fixture credentials or administrator credentials into services.

# Free core preview: set true in API runtime and web/mobile build environments.
DAYNORI_CORE_PREVIEW=true
NEXT_PUBLIC_DAYNORI_CORE_PREVIEW=true
EXPO_PUBLIC_DAYNORI_CORE_PREVIEW=true
# Leave storage/scanner/push credentials unset and do not deploy a worker in this profile.

# API + worker
NODE_ENV=production
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=daynori_runtime
DB_PASSWORD=
DB_POOL_MAX=5
PGSSLMODE=verify-full
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
REAUTH_SIGNING_SECRET=
DAYNORI_API_ORIGIN=
DAYNORI_WEB_ORIGIN=
STORAGE_CAPABILITY_SECRET=
# ClamAV must be reachable only through the private service network.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Worker only. Activate the NOLOGIN application role with a unique secret in
# the disposable cloud database. Do not share the API password or DB admin role.
WORKER_DB_USER=daynori_worker
WORKER_DB_PASSWORD=
FCM_SERVICE_ACCOUNT_JSON=
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Next.js server only; service role keys never belong here.
DAYNORI_API_URL=
SUPABASE_AUTH_URL=
SUPABASE_ANON_KEY=

# Android build inputs are public, embedded in the APK.
EXPO_PUBLIC_DAYNORI_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Native build only. The JSON is a Firebase Android client config for
# com.daynori.app, never an FCM service-account private key.
DAYNORI_GOOGLE_SERVICES_FILE=
DAYNORI_EXPO_PROJECT_ID=
