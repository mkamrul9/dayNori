# Database runtime credentials (least-privilege role)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=daynori_test
DB_USER=daynori_runtime
DB_PASSWORD=

# Database admin credentials (migrations and maintenance only)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=daynori_test
PGUSER=postgres
PGPASSWORD=

# Web server configuration for a real deployment:
# DAYNORI_WEB_ORIGIN=https://your-web-host.example
# DAYNORI_API_URL=https://your-api-host.example
# SUPABASE_AUTH_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# PGSSLMODE=verify-full
# Mobile build inputs are public and embedded into the APK. Never put database
# passwords, service-role keys, or signing secrets in EXPO_PUBLIC_*.
# EXPO_PUBLIC_DAYNORI_API_URL=https://your-api-host.example
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Provisional local rooms + chat (Phases 51–53). Ignored when NODE_ENV=production.
# DAYNORI_ROOMS_LOCAL_ENABLED=true

# Provisional local billing (Phase 57). Fail-closed when NODE_ENV=production.
# DAYNORI_BILLING_LOCAL_ENABLED=true
# Protected billing DB role (migration 00068). Not a release credential; ordinary
# daynori_runtime cannot self-assert authority via set_config or the local token.
# BILLING_DB_USER=daynori_billing
# BILLING_DB_PASSWORD=billing_dev_secret_9876
# Optional secret rotation helper (billing role / admin only). Never a runtime credential.
# DAYNORI_BILLING_SERVICE_TOKEN=daynori-local-billing-service-token-v1-not-production
# Live Play verification (requires credentials; never enables vault/rooms/AI).
# DAYNORI_BILLING_PRODUCTION_ENABLED=true
# DAYNORI_PLAY_ACCESS_TOKEN=
# DAYNORI_PLAY_PACKAGE_NAME=com.daynori.app
# Set all three for the $0 testing profile; upload and reminder writes are rejected.
DAYNORI_CORE_PREVIEW=false
NEXT_PUBLIC_DAYNORI_CORE_PREVIEW=false
EXPO_PUBLIC_DAYNORI_CORE_PREVIEW=false

# Private object storage (server-only). Never put service-role keys in NEXT_PUBLIC_* / EXPO_PUBLIC_*.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# DAYNORI_API_ORIGIN=https://api.your-host.example
# STORAGE_CAPABILITY_SECRET=replace-with-32-plus-char-random-secret
# Optional non-production in-memory object store when Supabase storage is unset:
# DAYNORI_LOCAL_MEMORY_STORAGE=true

# Malware scanner (fail-closed when unset in production). Policy scanner is heuristic only.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# MALWARE_SCANNER_URL=https://scanner.your-host.example/scan
# DAYNORI_ALLOW_POLICY_SCANNER=true
