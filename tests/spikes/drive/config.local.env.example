# Daynori Google Drive Spike Local Configuration Template
# Copy this file to config.local.env and populate with your test credentials.
# DO NOT COMMIT config.local.env to version control (it is gitignored).

# Google Cloud OAuth 2.0 Web Client Credentials
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web Application)
DAYNORI_DRIVE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
DAYNORI_DRIVE_CLIENT_SECRET="GOCSPX-your-client-secret"
DAYNORI_DRIVE_CLIENT_TYPE="web"

# OAuth 2.0 Redirect URI (Must exactly match authorized redirect URI in Google Cloud Console)
DAYNORI_DRIVE_REDIRECT_URI="http://127.0.0.1:8765/oauth2callback"

# Scope: Daynori strictly requires narrow per-file authorization
DAYNORI_DRIVE_REQUESTED_SCOPE="https://www.googleapis.com/auth/drive.file"

# Google Picker API Key (APIs & Services > Credentials > API Key; enable Google Picker API)
DAYNORI_DRIVE_API_KEY="AIzaSy-your-google-picker-api-key"
DAYNORI_DRIVE_PICKER_ENABLED="true"

# Synthetic Test Account Hint (e.g. dedicated testing email)
DAYNORI_DRIVE_LOGIN_HINT="daynori-test-audit@example.com"

# Optional Fixture IDs for Automated Probes in Test Folder:
# DAYNORI_DRIVE_SELECTED_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz-folder"
# DAYNORI_DRIVE_SELECTED_FILE_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz-picked-file"
# DAYNORI_DRIVE_NEVER_SELECTED_FILE_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz-unpicked-file"
