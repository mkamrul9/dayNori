# Copy to config.local.env (gitignored). Never commit secrets.
DAYNORI_DRIVE_CLIENT_ID=
# Only if the OAuth client type requires a secret (keep server-side; never embed in mobile).
DAYNORI_DRIVE_CLIENT_SECRET=
DAYNORI_DRIVE_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
# Optional: force a clean account hint
DAYNORI_DRIVE_LOGIN_HINT=
# Requested scope for the narrow experiment (do not broaden silently)
DAYNORI_DRIVE_REQUESTED_SCOPE=https://www.googleapis.com/auth/drive.file
