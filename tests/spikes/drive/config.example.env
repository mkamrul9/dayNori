# Copy to config.local.env (gitignored). Never commit secrets.
#
# Required for --mode=live:
DAYNORI_DRIVE_CLIENT_ID=
# web | installed  (web requires client secret for code exchange)
DAYNORI_DRIVE_CLIENT_TYPE=web
DAYNORI_DRIVE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud Console
DAYNORI_DRIVE_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
# Exact approved scope only (do not append broader Drive scopes)
DAYNORI_DRIVE_REQUESTED_SCOPE=https://www.googleapis.com/auth/drive.file
#
# Google Cloud APIs to enable for this test project:
# - Google Drive API
# - Google Picker API
#
# Picker (browser page on :8766) needs a browser API key restricted appropriately:
DAYNORI_DRIVE_API_KEY=
DAYNORI_DRIVE_PICKER_ENABLED=true
#
# Optional account hint (not a secret, but keep test-only):
DAYNORI_DRIVE_LOGIN_HINT=
#
# Optional fixture IDs (synthetic objects in the test account):
DAYNORI_DRIVE_NEVER_SELECTED_FILE_ID=
DAYNORI_DRIVE_SELECTED_FILE_ID=
DAYNORI_DRIVE_SELECTED_FOLDER_ID=
