{
  "name": "daynori-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Daynori: a customizable home for notes, routines, tasks, journals, and everyday life",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": "^24.21.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e:web": "node scripts/test-web-e2e.mjs",
    "test:e2e:android": "node scripts/test-android-e2e.mjs",
    "test:security": "vitest run tests/security",
    "test:performance": "vitest run tests/performance",
    "dev:web": "pnpm --filter @daynori/web dev",
    "dev:api": "pnpm --filter @daynori/api dev",
    "dev:mobile": "pnpm --filter @daynori/mobile dev",
    "dev:worker": "pnpm --filter @daynori/worker dev",
    "validate:planning": "node scripts/validate-planning.mjs",
    "audit": "pnpm audit:secrets && pnpm audit:deps",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:android-path": "node scripts/mobile-android-release-path.mjs",
    "release:web-smoke": "node scripts/phase60-web-production-smoke.mjs",
    "release:rehearsal": "node scripts/phase60-local-rehearsal.mjs",
    "validate:core": "node scripts/core-organizer-local-validation.mjs",
    "build:android:debug-apk": "node scripts/build-android-debug-apk.mjs",
    "ios:path": "node scripts/mobile-ios-path.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.20.1",
    "fake-indexeddb": "^6.2.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "~18.3.12",
      "@types/react-dom": "~18.3.5",
      "tar": "^7.5.22",
      "@xmldom/xmldom": "^0.8.15",
      "image-size": "^2.0.4",
      "postcss": "^8.5.30"
    },
    "patchedDependencies": {
      "tar@7.5.22": "patches/tar@7.5.22.patch"
    }
  }
}
