{
  "expo": {
    "name": "Daynori",
    "slug": "daynori",
    "version": "0.1.0",
    "scheme": "daynori",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "android": {
            "useSQLCipher": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F172A"
        }
      ]
    ],
    "android": {
      "package": "com.daynori.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "daynori" }, { "scheme": "https", "host": "app.daynori.com" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
