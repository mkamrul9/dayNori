{
  "name": "@daynori/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Expo React Native mobile application for Daynori (Android-first)",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --no-install -p android && node -e \"if (!require('fs').existsSync('android/build.gradle')) { console.error('Native android generation failed'); process.exit(1); }\"",
    "build": "expo export -p android"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@daynori/contracts": "workspace:*",
    "@daynori/design-tokens": "workspace:*",
    "@daynori/ui-mobile": "workspace:*",
    "@expo/metro-config": "~0.19.0",
    "expo": "~52.0.30",
    "expo-dev-client": "~5.0.20",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "devDependencies": {
    "@daynori/config": "workspace:*",
    "@daynori/test-utils": "workspace:*",
    "@types/react": "~18.3.12",
    "expo-modules-autolinking": "~2.0.8",
    "typescript": "^5.7.3"
  }
}
